# Ladda — environment. Copy to `.env.local` and fill in. Never commit real values.
# (`prisma` also reads `.env`; keep the same values there for CLI commands.)

# --- AI (LADDA_BUILD_SPEC.md §3) ---
# Pin the model with an id, never a literal in code. Read it via process.env.ANTHROPIC_MODEL.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Supabase: Postgres + Auth (§3) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Credential issuer keypair (§3, §8) ---
# ed25519, hex. Generate once with `npm run gen:key` and paste the output here.
LADDA_ISSUER_PRIVATE_KEY=
NEXT_PUBLIC_LADDA_ISSUER_PUBLIC_KEY=

# --- Prisma / Postgres connection (required by prisma/schema.prisma; not in the §3 list) ---
# Supabase → Project Settings → Database. Use the pooled URL for DATABASE_URL
# and the direct (non-pooled) URL for DIRECT_URL (used by migrations).
DATABASE_URL=
DIRECT_URL=
